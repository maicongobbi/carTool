generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

plugin hooks {
  provider = '@zenstackhq/tanstack-query'
  target = 'react'
  output = './app/lib/hooks'
}
// ==========================================
// Tabelas do BetterAuth (Necessárias)
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
    
  // Relacionamento com veículos no ZenStack (multi-tenancy)
  vehicles      Vehicle[]
  maintenanceCategories MaintenanceCategory[]

  // O próprio usuário pode ler ou atualizar o seu perfil
  @@allow('read,update', auth() == this)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@allow('all', auth().id == userId)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@allow('all', auth().id == userId)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@allow('all', true)
}

// ==========================================
// Domínio da Aplicação: CarTool
// ==========================================
model Vehicle {
  id            String   @id @default(cuid())
  type          String   @default("Carro")
  brand         String
  model         String
  year          Int
  modelYear     Int?
  purchasePrice Float?
  purchaseDate  DateTime?
  saleDate      DateTime?
  initialKm     Int
  currentKm     Int
  fipeCode      String?
  notes         String?

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  technicalInfos     TechnicalInfo[]
  maintenanceRecords MaintenanceRecord[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@allow('all', auth().id == userId)
}

model MaintenanceCategory {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  technicalInfos     TechnicalInfo[]
  maintenanceRecords MaintenanceRecord[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@allow('all', auth().id == userId)
}

model TechnicalInfo {
  id                 String   @id @default(cuid())
  description        String
  kmInterval         Int?
  timeIntervalMonths Int?
  
  categoryId         String
  category           MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  maintenanceRecords MaintenanceRecord[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@allow('all', vehicle.userId == auth().id)
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  date            DateTime
  kmAtService     Int
  description     String
  cost            Float?
  nextDate        DateTime?
  nextKm          Int?

  // Referência opcional a um item do plano de manutenção
  technicalInfoId String?
  technicalInfo   TechnicalInfo? @relation(fields: [technicalInfoId], references: [id], onDelete: SetNull)

  // Categoria (obrigatória)
  categoryId      String
  category        MaintenanceCategory @relation(fields: [categoryId], references: [id])

  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@allow('all', vehicle.userId == auth().id)
}